// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "ROS noetic",
	"build": {
		"dockerfile": "../docker/Dockerfile",
		"context": ".."
	},

	"containerEnv" : {
		"CONT_PWD" : "${containerWorkspaceFolder}",
		"DISPLAY" : "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM" : "1"
	},

	"remoteUser": "devel",

	"remoteEnv": { 
		"DISPLAY": "${localEnv:DISPLAY}" 
	},

	"runArgs": [
		"--name", "${containerWorkspaceFolderBasename}_devcont",
		"--hostname", "${containerWorkspaceFolderBasename}_devcont",
		"--privileged",
    	"--net=host",
		"--runtime=nvidia",
		"--env", "DISPLAY=${localEnv:DISPLAY}",
		"--env", "QT_X11_NO_MITSHM=1",
		"--env", "XDG_RUNTIME_DIR=/tmp",
		"--device-cgroup-rule=c 189:* rmw",
		"--add-host", "ur10_final_project_devcont:127.0.0.1",
        "--group-add=plugdev",
        "--group-add=video"
	],

	"mounts": [
		{ 
			"source": "/dev/dri", 
			"target": "/dev/dri",
			"type": "bind"
		},
		{ 
			"source": "/tmp/.X11-unix", 
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{ 
			"source": "/dev", 
			"target": "/dev",
			"type": "bind"
		},

		{ 
            "source": "/dev/bus/usb", 
            "target": "/dev/bus/usb",
            "type": "bind" 
        }
		,
		{ 
		 	"source": "/home/${localEnv:USER}/TUM//ur10_final_project", 
		 	"target": "/UR10_WS",
		 	"type": "bind"
		}
	],

	"postCreateCommand": "sudo dpkg -i /workspaces/ur10_final_project/noetic_ubuntu20/*.deb || sudo apt-get install -f -y",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"cschlosser.doxdocgen",
				"shd101wyy.markdown-preview-enhanced"
			]
		}
	}
}